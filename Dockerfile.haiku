# Default: 32-bit x86 (gcc13 secondary arch of x86_gcc2h). 64-bit:
#   --build-arg IMAGE_TAG=x86_64-r1beta5 --build-arg TOOLS=cross-tools-x86_64 \
#   --build-arg TRIPLE=x86_64-unknown-haiku --build-arg CPU_FAMILY=x86_64 --build-arg CPU=x86_64 \
#   --build-arg INC= --build-arg INC_MESON=
ARG IMAGE_TAG=x86_gcc2h-r1beta5
FROM ghcr.io/haiku/cross-compiler:${IMAGE_TAG}

ARG TOOLS=cross-tools-x86
ARG TRIPLE=i586-pc-haiku
ARG CPU_FAMILY=x86
ARG CPU=i586
# gcc13 secondary arch must see headers/x86 before the gcc2 primary ones
ARG INC="-isystem /system/develop/headers/x86/os/opengl -isystem /system/develop/headers/x86/os -isystem /system/develop/headers/x86"
ARG INC_MESON="'-isystem', '/system/develop/headers/x86/os/opengl', '-isystem', '/system/develop/headers/x86/os', '-isystem', '/system/develop/headers/x86'"
ENV CFLAGS="${INC}" CXXFLAGS="${INC}"
ENV TRIPLE=${TRIPLE}

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/opt/venv/bin:/tools/${TOOLS}/bin:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv git wget ca-certificates xz-utils zip \
    pkg-config make autoconf automake libtool && \
    rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv && pip install --no-cache-dir meson ninja

# node for the JS actions when this image is a CI job container
RUN wget -q https://nodejs.org/dist/v20.18.1/node-v20.18.1-linux-x64.tar.xz && \
    tar -xJf node-v20.18.1-linux-x64.tar.xz -C /usr/local --strip-components=1 && \
    rm node-v20.18.1-linux-x64.tar.xz && node --version

ENV PREFIX=/opt/haiku-deps
WORKDIR /opt

RUN wget -q https://github.com/libsdl-org/SDL/releases/download/release-2.32.2/SDL2-2.32.2.tar.gz && \
    tar -xzf SDL2-2.32.2.tar.gz && rm SDL2-2.32.2.tar.gz && \
    cd SDL2-2.32.2 && mkdir build && cd build && \
    cmake .. \
      -DCMAKE_SYSTEM_NAME=Haiku \
      -DCMAKE_SYSTEM_PROCESSOR=${CPU} \
      -DCMAKE_C_COMPILER=${TRIPLE}-gcc \
      -DCMAKE_CXX_COMPILER=${TRIPLE}-g++ \
      -DCMAKE_FIND_ROOT_PATH=/tools/${TOOLS}/sysroot \
      -DCMAKE_INSTALL_PREFIX=${PREFIX} \
      -DSDL_STATIC=ON -DSDL_SHARED=OFF -DSDL_TEST=OFF && \
    make -j$(nproc) && make install

RUN wget -q https://downloads.xiph.org/releases/ogg/libogg-1.3.5.tar.gz && \
    tar -xzf libogg-1.3.5.tar.gz && rm libogg-1.3.5.tar.gz && \
    cd libogg-1.3.5 && \
    ./configure --host=${TRIPLE} --prefix=${PREFIX} --disable-shared --enable-static && \
    make -j$(nproc) && make install

RUN wget -q https://downloads.xiph.org/releases/vorbis/libvorbis-1.3.7.tar.gz && \
    tar -xzf libvorbis-1.3.7.tar.gz && rm libvorbis-1.3.7.tar.gz && \
    cd libvorbis-1.3.7 && \
    ./configure --host=${TRIPLE} --prefix=${PREFIX} --disable-shared --enable-static \
      --with-ogg=${PREFIX} && \
    make -j$(nproc) && make install

RUN cat > /cross-haiku.txt <<EOT
[binaries]
c = '${TRIPLE}-gcc'
cpp = '${TRIPLE}-g++'
ar = '${TRIPLE}-ar'
strip = '${TRIPLE}-strip'
pkgconfig = 'pkg-config'
cmake = '/usr/bin/cmake'

[host_machine]
system = 'haiku'
cpu_family = '${CPU_FAMILY}'
cpu = '${CPU}'
endian = 'little'

[properties]
pkg_config_libdir = '/opt/haiku-deps/lib/pkgconfig'
needs_exe_wrapper = true

[built-in options]
c_args = [${INC_MESON}]
cpp_args = [${INC_MESON}]
EOT

WORKDIR /project
CMD ["/bin/bash"]
